# ─────────────────────────────────────────────────────────────
# AHRAS v7 Environment Configuration
# ─────────────────────────────────────────────────────────────

# MongoDB (required for data persistence)
# Install: https://www.mongodb.com/try/download/community
# Or use Docker: docker run -d -p 27017:27017 mongo:7
MONGO_URI=mongodb://localhost:27017
MONGO_DB=AHRAS_DB

# If MongoDB is unavailable, AHRAS runs in memory-only mode
# (data is lost on restart but everything still works)

# Auth
SECRET_KEY=ahras-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Server
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# Detection thresholds
NETWORK_INTERFACE=
PORT_SCAN_THRESHOLD=20
FLOOD_THRESHOLD=500
SSH_BRUTEFORCE_THRESHOLD=10
RISK_WINDOW_SECONDS=60
TRUST_IP_WHITELIST=127.0.0.1,10.0.1.138

# ML model
MODEL_PATH=models/anomaly_model.pkl
TRAIN_SAMPLES=1000
CONTAMINATION=0.05

# Firewall — keep FALSE on personal machines
FIREWALL_ENABLED=false
AUTO_BLOCK_ENABLED=false
AUTO_BLOCK_RISK_THRESHOLD=9.0
PORT_CONTROL_ENABLED=false

# Honeypot ports
HONEYPOT_SSH_PORT=2222
HONEYPOT_FTP_PORT=2121
HONEYPOT_HTTP_PORT=8081

# Threat Intelligence API keys (all optional)
ABUSEIPDB_KEY=
VIRUSTOTAL_KEY=
OTX_KEY=
