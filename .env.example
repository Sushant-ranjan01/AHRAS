# AHRAS v3.0 Environment Configuration
# Copy this file to .env and fill in your values

# ── Core ──────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-string-in-production
AHRAS_HOST=0.0.0.0
AHRAS_PORT=8000
DEBUG=true

# CORS — comma-separated list of frontend origins allowed to call this API
# from a browser. Leave unset for local dev (defaults to localhost only when
# DEBUG=true). REQUIRED before deploying anywhere real — see main.py.
# ALLOWED_ORIGINS=https://ahras.yourcompany.com

# ── Threat Intelligence API Keys (optional but recommended) ──
# AbuseIPDB: https://www.abuseipdb.com/api
ABUSEIPDB_KEY=

# VirusTotal: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_KEY=

# AlienVault OTX: https://otx.alienvault.com/
OTX_KEY=

# ── Honeypot Ports ────────────────────────────────────────
HONEYPOT_SSH_PORT=2222
HONEYPOT_FTP_PORT=2121
HONEYPOT_HTTP_PORT=8081

# ── Notification Settings (future) ───────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# SLACK_WEBHOOK_URL=
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_PORT=587
# EMAIL_FROM=
# EMAIL_PASSWORD=

# Production security
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=10
ALLOWED_ORIGINS=http://localhost:8000
# Production Mongo credentials are supplied through docker-compose.prod.yml
MONGO_ROOT_USERNAME=ahras_admin
MONGO_ROOT_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
